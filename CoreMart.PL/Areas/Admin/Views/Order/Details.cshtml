@model OrderVM

@{
    ViewData["Title"] = "Order Details";
    ViewBag.PageTitle = "Order Details";
}

<form method="post">
    <input hidden asp-for="OrderHeader.Id" />

    <div class="row g-4">
        <!-- Left Column: Shipping & Payment Details -->
        <div class="col-lg-7">
            <div class="cm-card p-4 mb-4">
                <h3 class="h5 fw-bold mb-4 pb-2 border-bottom text-primary d-flex align-items-center gap-2">
                    <i class="bi bi-geo-alt-fill"></i> Shipping Information
                </h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="OrderHeader.FullName" class="cm-form-label">Full Name</label>
                        <input asp-for="OrderHeader.FullName" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="OrderHeader.Phone" class="cm-form-label">Phone</label>
                        <input asp-for="OrderHeader.Phone" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label asp-for="OrderHeader.Address" class="cm-form-label">Address</label>
                        <input asp-for="OrderHeader.Address" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="cm-form-label">Email</label>
                        <input asp-for="OrderHeader.ApplicationUser.Email" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="cm-form-label">Order Date</label>
                        <input value="@(Model.OrderHeader?.OrderDate.ToShortDateString() ?? "")" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="OrderHeader.Carrier" class="cm-form-label">Carrier</label>
                        <input asp-for="OrderHeader.Carrier" id="Carrier" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="OrderHeader.TrackingNumber" class="cm-form-label">Tracking Number</label>
                        <input asp-for="OrderHeader.TrackingNumber" id="TrackingNumber" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="cm-form-label">Shipping Date</label>
                        <input value="@(Model.OrderHeader?.ShippingDate.ToShortDateString() ?? "")" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="cm-form-label">Payment Date</label>
                        <input value="@(Model.OrderHeader?.OrderDate.ToShortDateString() ?? "")" class="form-control" readonly />
                    </div>
                </div>
            </div>
            <div class="cm-card p-4">
                <h3 class="h5 fw-bold mb-4 pb-2 border-bottom text-primary d-flex align-items-center gap-2">
                    <i class="bi bi-credit-card-2-front-fill"></i> Payment Details
                </h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="cm-form-label">Session ID</label>
                        <input asp-for="OrderHeader.SessionId" class="form-control text-muted small" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="cm-form-label">Payment Intent ID</label>
                        <input asp-for="OrderHeader.PaymentIntendId" class="form-control text-muted small" readonly />
                    </div>
                    <div class="col-12">
                        <label class="cm-form-label">Payment Status</label>
                        <input asp-for="OrderHeader.paymentStatus" class="form-control fw-semibold" readonly />
                    </div>
                </div>
                <div class="mt-4">
                    <button type="submit" asp-action="UpdateOrderDetails" class="btn btn-cm-primary">
                        <i class="bi bi-check-lg me-1"></i> Update Details
                    </button>
                </div>
            </div>
        </div>

        <!-- Right Column: Order Summary -->
        <div class="col-lg-5">
            <div class="cm-card p-4">
                <h3 class="h5 fw-bold mb-3 pb-2 border-bottom text-primary d-flex align-items-center gap-2">
                    <i class="bi bi-receipt-cutoff"></i> Order Summary
                </h3>

                @{
                    string statusColor = Model.OrderHeader.OrderStatus switch
                    {
                        "Approved" => "text-bg-info",
                        "Processing" => "text-bg-warning",
                        "Shipped" => "text-bg-primary",
                        "Cancelled" => "text-bg-danger",
                        "Refund" => "text-bg-secondary",
                        _ => "text-bg-dark"
                    };
                }
                <div class="d-flex align-items-center gap-2 mb-4">
                    <span class="badge @statusColor px-3 py-2 rounded-pill fs-6">@(Model.OrderHeader?.OrderStatus ?? "N/A")</span>
                </div>

                <div class="mb-4" style="max-height: 350px; overflow-y: auto;">
                    @if (Model.OrderDetails != null)
                    {
                        foreach (var detail in Model.OrderDetails)
                        {
                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                <div>
                                    <div class="fw-bold">@(detail.Product?.Name ?? "Unknown Product")</div>
                                    <small class="text-muted">@detail.Price.ToString("c") × @detail.Count</small>
                                </div>
                                <span class="fw-bold text-success">@((detail.Count * detail.Price).ToString("c"))</span>
                            </div>
                        }
                    }
                </div>

                <div class="p-3 bg-light rounded-3 border d-flex justify-content-between align-items-center fw-bold fs-5">
                    <span>Total:</span>
                    <span class="text-primary fs-4">@(Model.OrderHeader?.TotalAmount.ToString("c") ?? "$0.00")</span>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    @if (Model.OrderHeader.OrderStatus == "Approved")
                    {
                        <button type="submit" asp-action="StartProcess" class="btn btn-cm-primary flex-grow-1">
                            <i class="bi bi-gear me-1"></i> Start Processing
                        </button>
                    }
                    @if (Model.OrderHeader.OrderStatus == "Processing")
                    {
                        <button type="submit" asp-action="StartShip" onclick="return CheckData()" class="btn btn-cm-primary flex-grow-1">
                            <i class="bi bi-truck me-1"></i> Start Shipping
                        </button>
                    }
                    @if (Model.OrderHeader.OrderStatus != "Cancelled" && Model.OrderHeader.OrderStatus != "Refund")
                    {
                        <button type="submit" class="btn btn-cm-danger flex-grow-1">
                            <i class="bi bi-x-circle me-1"></i> Cancel Order
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</form>

@section Script {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function CheckData() {
            if (document.getElementById("Carrier").value.trim() === '') {
                Swal.fire({ title: "Error", text: "Please enter the carrier name", icon: "error", confirmButtonColor: "#4f46e5" });
                return false;
            }
            if (document.getElementById("TrackingNumber").value.trim() === '') {
                Swal.fire({ title: "Error", text: "Please enter the tracking number", icon: "error", confirmButtonColor: "#4f46e5" });
                return false;
            }
            return true;
        }
    </script>
}
