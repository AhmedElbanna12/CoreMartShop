@{
    ViewData["Title"] = "Order Management";
    ViewBag.PageTitle = "Orders Management";
}

<div class="cm-card p-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="h4 fw-bold mb-1">Orders</h2>
            <p class="text-muted mb-0">Track and manage all customer orders</p>
        </div>
    </div>

    <div class="cm-table-responsive">
        <table id="productTable" class="cm-table align-middle" style="width: 100%;">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Customer</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Script {
    <script src="~/js/Order.js"></script>
}
