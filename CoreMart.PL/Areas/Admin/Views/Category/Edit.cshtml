@model Category

@{
    ViewData["Title"] = "Edit Category";
    ViewBag.PageTitle = "Edit Category";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="cm-card p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <h2 class="h4 fw-bold mb-0">Edit Category</h2>
                <a asp-action="Index" class="btn btn-cm-outline"><i class="bi bi-arrow-left me-1"></i> Back</a>
            </div>
            <form asp-controller="Category" asp-action="Edit" method="post" enctype="multipart/form-data">
                <input asp-for="Id" type="hidden" />
                <input asp-for="ImageURL" type="hidden" />
                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="Name" class="cm-form-label">Category Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Description" class="cm-form-label">Description</label>
                        <input asp-for="Description" class="form-control" />
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        @if (!string.IsNullOrEmpty(Model.ImageURL))
                        {
                            <label class="cm-form-label">Current Image</label>
                            <div class="mb-3 p-3 bg-light rounded border text-center">
                                <img src="~/@Model.ImageURL" alt="Current" class="rounded" style="max-height: 120px; object-fit: contain;" />
                            </div>
                        }
                        <label class="cm-form-label">Replace Image (optional)</label>
                        <input type="file" name="file" class="form-control" accept="image/*" />
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-cm-outline">Cancel</a>
                    <button type="submit" class="btn btn-cm-primary"><i class="bi bi-check-lg me-1"></i> Update Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Script {
    <partial name="_ValidationScriptsPartial" />
}
