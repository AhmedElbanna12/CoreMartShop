@model IEnumerable<ApplicationUser>

@{
    ViewData["Title"] = "Users Management";
    ViewBag.PageTitle = "Users Management";
}

<div class="cm-card p-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="h4 fw-bold mb-1">Users</h2>
            <p class="text-muted mb-0">Manage registered users and account access</p>
        </div>
        <a href="/Identity/Account/Register" class="btn btn-cm-primary">
            <i class="bi bi-person-plus me-1"></i> Create New User
        </a>
    </div>

    <div class="cm-table-responsive">
        <table class="cm-table align-middle">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="3" class="text-center py-4 text-muted">No users found.</td></tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                                        @(item.Email?.Substring(0, 1).ToUpper() ?? "?")
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@(item.FullName ?? item.Email)</div>
                                        <small class="text-muted">@item.Email</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (item.LockoutEnd == null || item.LockoutEnd < DateTime.Now)
                                {
                                    <span class="cm-badge cm-badge-success">Active</span>
                                }
                                else
                                {
                                    <span class="cm-badge cm-badge-danger">Locked</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (item.LockoutEnd == null || item.LockoutEnd < DateTime.Now)
                                {
                                    <a asp-action="LockUnlock" asp-route-id="@item.Id" class="btn btn-sm btn-cm-outline py-1 px-2 me-1" title="Lock User">
                                        <i class="bi bi-lock-fill me-1"></i> Lock
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="LockUnlock" asp-route-id="@item.Id" class="btn btn-sm btn-cm-primary py-1 px-2 me-1" title="Unlock User">
                                        <i class="bi bi-unlock-fill me-1"></i> Unlock
                                    </a>
                                }
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-cm-danger py-1 px-2">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
