@model IEnumerable<Product>

@{
    ViewData["Title"] = "Product List";
    ViewBag.PageTitle = "Products Management";
}

<div class="cm-card p-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="h4 fw-bold mb-1">Products</h2>
            <p class="text-muted mb-0">Manage all items in your store inventory</p>
        </div>
        <a asp-action="Create" class="btn btn-cm-primary">
            <i class="bi bi-plus-lg me-1"></i> Add New Product
        </a>
    </div>

    <div class="cm-table-responsive">
        <table class="cm-table align-middle">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Product Name</th>
                    <th>Category</th>
                    <th>Brand</th>
                    <th>Price</th>
                    <th>Description</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center py-4 text-muted">No products found.</td></tr>
                }
                else
                {
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td style="width: 70px;">
                                @if (!string.IsNullOrEmpty(product.ImageURL))
                                {
                                    <img src="~/@product.ImageURL" alt="@product.Name" class="rounded border" width="55" height="55" style="object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="bg-light rounded border d-flex align-items-center justify-content-center text-muted" style="width: 55px; height: 55px;"><i class="bi bi-image"></i></div>
                                }
                            </td>
                            <td class="fw-bold text-dark">@product.Name</td>
                            <td><span class="cm-badge cm-badge-info">@(product.Category?.Name ?? "—")</span></td>
                            <td><span class="cm-badge cm-badge-warning">@(product.Brand?.Name ?? "—")</span></td>
                            <td class="fw-bold text-primary">@product.Price.ToString("C")</td>
                            <td class="text-muted small text-truncate" style="max-width: 220px;">@product.Description</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-cm-outline py-1 px-2 me-1"><i class="bi bi-pencil me-1"></i>Edit</a>
                                <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-cm-danger py-1 px-2"><i class="bi bi-trash me-1"></i>Delete</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Script {
    <script src="~/js/Product.js"></script>
}