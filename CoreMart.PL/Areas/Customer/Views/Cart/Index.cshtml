@model ShoppingCartVM

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container px-4 px-lg-5 my-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="h2 fw-bold mb-1"><i class="bi bi-cart3 me-2 text-primary"></i> Shopping Cart</h1>
            <p class="text-muted mb-0">Review your selected items before proceeding to checkout</p>
        </div>
        <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-cm-outline mt-3 mt-md-0">
            <i class="bi bi-arrow-left me-1"></i> Continue Shopping
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            @if (Model.CartList == null || !Model.CartList.Any())
            {
                <div class="cm-card p-5 text-center">
                    <i class="bi bi-cart-x text-muted display-1 d-block mb-3"></i>
                    <h3 class="fw-bold">Your cart is empty</h3>
                    <p class="text-muted mb-4">Looks like you haven't added any items yet.</p>
                    <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-cm-primary">Explore Products</a>
                </div>
            }
            else
            {
                <div class="cm-card p-3">
                    @foreach (var item in Model.CartList)
                    {
                        <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between p-3 border-bottom gap-3">
                            <div class="d-flex align-items-center gap-3">
                                <img src="~/@item.Product.ImageURL" alt="@item.Product.Name" class="rounded-3 border" style="width: 90px; height: 90px; object-fit: cover;" />
                                <div>
                                    <h5 class="fw-bold mb-1">@item.Product.Name</h5>
                                    <p class="text-muted small mb-2 text-truncate" style="max-width: 280px;">@item.Product.Description</p>
                                    <div class="fw-bold text-primary fs-6">@item.Product.Price.ToString("C")</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center justify-content-between justify-content-sm-end gap-4 mt-2 mt-sm-0">
                                <div class="d-flex align-items-center border rounded-pill bg-light p-1">
                                    <a asp-action="Minus" asp-route-cartid="@item.Id" class="btn btn-sm btn-light rounded-circle fw-bold px-2 py-0" style="width: 28px; height: 28px;">-</a>
                                    <span class="px-3 fw-bold fs-6">@item.Count</span>
                                    <a asp-action="Plus" asp-route-cartid="@item.Id" class="btn btn-sm btn-light rounded-circle fw-bold px-2 py-0" style="width: 28px; height: 28px;">+</a>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-dark mb-1">@((item.Product.Price * item.Count).ToString("C"))</div>
                                    <a asp-action="Remove" asp-route-cartid="@item.Id" class="text-danger small text-decoration-none fw-semibold">
                                        <i class="bi bi-trash me-1"></i> Remove
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="cm-card p-4">
                <h3 class="h5 fw-bold mb-4 border-bottom pb-3">Order Summary</h3>
                <div class="d-flex justify-content-between mb-3 text-muted">
                    <span>Subtotal</span>
                    <span class="fw-semibold text-dark">@Model.TotalCarts.ToString("C")</span>
                </div>
                <div class="d-flex justify-content-between mb-3 text-muted">
                    <span>Shipping</span>
                    <span class="text-success fw-semibold">Free</span>
                </div>
                <hr class="my-3" />
                <div class="d-flex justify-content-between mb-4">
                    <span class="fw-bold fs-5">Total (USD)</span>
                    <span class="fw-bold fs-4 text-primary">@Model.TotalCarts.ToString("C")</span>
                </div>
                @if (Model.CartList != null && Model.CartList.Any())
                {
                    <a href="/Customer/Cart/Summary" class="btn btn-cm-primary w-100 py-3 fs-6">
                        Proceed to Checkout <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                }
                else
                {
                    <button class="btn btn-cm-secondary w-100 py-3 fs-6" disabled>Proceed to Checkout</button>
                }
            </div>
        </div>
    </div>
</div>