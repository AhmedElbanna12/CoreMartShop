@model ShoppingCartVM
@using Microsoft.Extensions.Options
@inject IOptions<CoreMart.PL.Utility.StripeSettings> Stripe

@{
    ViewData["Title"] = "Checkout";
}

<div class="container px-4 px-lg-5 my-5">
    <div class="mb-4 pb-3 border-bottom">
        <h1 class="h2 fw-bold mb-1"><i class="bi bi-credit-card me-2 text-primary"></i> Checkout</h1>
        <p class="text-muted mb-0">Verify your shipping details and order summary</p>
    </div>

    <form method="post">
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="cm-card p-4">
                    <h3 class="h5 fw-bold mb-4 pb-2 border-bottom text-primary d-flex align-items-center gap-2">
                        <i class="bi bi-geo-alt-fill"></i> Shipping & Billing
                    </h3>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="OrderHeader.ApplicationUser.FullName" class="cm-form-label">Full Name</label>
                            <input asp-for="OrderHeader.ApplicationUser.FullName" class="form-control" placeholder="John Doe" />
                            <span asp-validation-for="OrderHeader.ApplicationUser.FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="OrderHeader.ApplicationUser.Email" class="cm-form-label">Email</label>
                            <input asp-for="OrderHeader.ApplicationUser.Email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="OrderHeader.ApplicationUser.Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="OrderHeader.Phone" class="cm-form-label">Phone</label>
                            <input asp-for="OrderHeader.Phone" class="form-control" placeholder="+1 (555) 000-0000" />
                            <span asp-validation-for="OrderHeader.Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="OrderHeader.Address" class="cm-form-label">Address</label>
                            <textarea asp-for="OrderHeader.Address" class="form-control" rows="3" placeholder="Street, city, state, zip"></textarea>
                            <span asp-validation-for="OrderHeader.Address" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
                <div class="mt-4">
                    <a href="@Url.Action("Index", "Cart", new { area = "Customer" })" class="btn btn-cm-outline">
                        <i class="bi bi-arrow-left me-1"></i> Return to Cart
                    </a>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="cm-card p-4">
                    <h3 class="h5 fw-bold mb-4 pb-2 border-bottom text-primary d-flex align-items-center gap-2">
                        <i class="bi bi-cart-check-fill"></i> Order Items
                    </h3>
                    <div class="mb-4" style="max-height: 320px; overflow-y: auto;">
                        @foreach (var item in Model.CartList)
                        {
                            <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                                <div class="position-relative flex-shrink-0">
                                    <img src="~/@item.Product.ImageURL" alt="@item.Product.Name" class="rounded border" style="width: 60px; height: 60px; object-fit: cover;">
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-dark">@item.Count</span>
                                </div>
                                <div class="flex-grow-1 min-width-0">
                                    <h6 class="mb-0 fw-bold text-truncate">@item.Product.Name</h6>
                                    <small class="text-muted">Qty: @item.Count</small>
                                </div>
                                <div class="fw-bold">@((item.Product.Price * item.Count).ToString("C"))</div>
                            </div>
                        }
                    </div>
                    <div class="p-3 bg-light rounded-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center fw-bold fs-5">
                            <span>Total:</span>
                            <span class="text-primary fs-4">@Model.OrderHeader.TotalAmount.ToString("C")</span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-cm-primary w-100 py-3 fs-6">
                        PROCEED TO PAYMENT <i class="bi bi-lock-fill ms-2"></i>
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://js.stripe.com/v3/"></script>
    <partial name="_ValidationScriptsPartial" />
}
