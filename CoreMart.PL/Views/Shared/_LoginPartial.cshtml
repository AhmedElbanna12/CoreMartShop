@using CoreMart.DAL.Models
@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center gap-2">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a id="manage" class="nav-link fw-semibold d-flex align-items-center gap-1" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
            <i class="bi bi-person-circle text-primary fs-5"></i>
            <span>@UserManager.GetUserName(User)</span>
        </a>
    </li>
    <li class="nav-item">
        <form id="logoutForm" class="form-inline m-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button id="logout" type="submit" class="btn btn-cm-outline py-1 px-3 small">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="btn btn-cm-outline py-1 px-3 small" id="register" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-cm-primary py-1 px-3 small" id="login" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
