@using Microsoft.AspNetCore.Http
@using CoreMart.PL.Utility;
@inject IHttpContextAccessor httpContextAccessor;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CoreMart</title>

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- CoreMart Modern Design System -->
    <link href="~/css/coremart-ui.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/Customer/css/styles.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Modern Navigation -->
    <nav class="navbar navbar-expand-lg cm-navbar shadow-sm">
        <div class="container px-4 px-lg-5">
            <a class="navbar-brand" href="@Url.Action("Index", "Home", new { area = "Customer" })">
                <i class="bi bi-bag-heart-fill text-primary"></i> CoreMart
            </a>
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="@Url.Action("Index", "Home", new { area = "Customer" })">
                            <i class="bi bi-house-door me-1"></i> Home
                        </a>
                    </li>
                    @if (User.Identity.IsAuthenticated)
                    {
                        if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold" href="/Admin/Product/Index">
                                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" id="navbarDropdown" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear me-1"></i> My Account
                                </a>
                                <ul class="dropdown-menu border shadow-sm rounded-3" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item py-2" href="#!"><i class="bi bi-box-seam me-2 text-muted"></i> My Orders</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item py-2" href="#!"><i class="bi bi-person me-2 text-muted"></i> Edit Profile</a></li>
                                </ul>
                            </li>
                        }
                    }
                </ul>

                <div class="d-flex align-items-center gap-3">
                    <!-- Cart Button -->
                    <a href="/Customer/Cart/Index" class="cm-cart-btn">
                        <i class="bi bi-cart3 fs-6 text-primary"></i>
                        <span>Cart</span>
                        @if (httpContextAccessor.HttpContext?.Session.GetInt32("ShoppingCartSession") != null)
                        {
                            <span class="cm-cart-badge">
                                @httpContextAccessor.HttpContext.Session.GetInt32("ShoppingCartSession")
                            </span>
                        }
                        else
                        {
                            <span class="cm-cart-badge">0</span>
                        }
                    </a>

                    @await Html.PartialAsync("_LoginPartial")
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Body Content -->
    <main class="flex-shrink-0">
        @RenderBody()
    </main>

    <!-- Modern Footer -->
    <footer class="cm-footer mt-auto">
        <div class="container px-4 px-lg-5">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold text-white mb-3">
                        <i class="bi bi-bag-heart-fill text-primary me-2"></i>CoreMart Shop
                    </h5>
                    <p class="small mb-0">
                        Your modern destination for quality products with seamless online shopping, secure checkout, and instant support.
                    </p>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Quick Links</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a href="@Url.Action("Index", "Home", new { area = "Customer" })">Home</a></li>
                        <li class="mb-2"><a href="/Customer/Cart/Index">Shopping Cart</a></li>
                        <li class="mb-2"><a href="/Identity/Account/Login">Account Login</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Customer Care</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a href="#!">Help & FAQs</a></li>
                        <li class="mb-2"><a href="#!">Shipping & Returns</a></li>
                        <li class="mb-2"><a href="#!">Privacy Policy</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Contact Support</h6>
                    <p class="small mb-1"><i class="bi bi-envelope me-2 text-primary"></i> support@coremart.com</p>
                    <p class="small mb-0"><i class="bi bi-telephone me-2 text-primary"></i> +1 (800) 123-4567</p>
                </div>
            </div>
            <hr class="border-secondary my-4" />
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <p class="m-0 text-center text-sm-start small">&copy; @DateTime.Now.Year CoreMart Shop. All rights reserved.</p>
                <div class="d-flex gap-3">
                    <i class="bi bi-credit-card-2-front fs-5"></i>
                    <i class="bi bi-shield-check fs-5"></i>
                    <i class="bi bi-lock fs-5"></i>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Customer/js/scripts.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Script", required: false)
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
