<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>CoreMart Admin Panel</title>

    <!-- Google Font & Bootstrap Icons -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=fallback">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/plugins/fontawesome-free/css/all.min.css">
    <!-- AdminLTE Theme style & CoreMart UI -->
    <link rel="stylesheet" href="/css/adminlte.min.css">
    <link rel="stylesheet" href="/css/coremart-ui.css" asp-append-version="true">
    <!-- DataTables & Toastr -->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.2.2/css/dataTables.dataTables.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">
        <!-- Main Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light border-bottom shadow-sm">
            <ul class="navbar-nav align-items-center">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a href="/Customer/Home/Index" class="nav-link text-primary fw-semibold">
                        <i class="bi bi-shop me-1"></i> View Storefront
                    </a>
                </li>
            </ul>

            <ul class="navbar-nav ml-auto align-items-center">
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button" title="Toggle Fullscreen">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center gap-2" href="/Identity/Account/Manage/Index">
                        <i class="bi bi-person-circle fs-5 text-primary"></i>
                        <span class="d-none d-md-inline fw-bold text-dark">Admin</span>
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Main Sidebar Container -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="/Admin/Product/Index" class="brand-link px-3 py-3 border-bottom border-secondary d-flex align-items-center gap-2 text-decoration-none">
                <i class="bi bi-bag-heart-fill text-primary fs-4"></i>
                <span class="brand-text fw-bold text-white fs-5">CoreMart Admin</span>
            </a>

            <div class="sidebar py-2">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column gap-1" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-header text-uppercase text-muted px-3 small fw-bold mb-1">Management</li>

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="nav-link d-flex align-items-center gap-2 py-2 px-3 rounded">
                                <i class="nav-icon bi bi-box-seam text-info fs-5"></i>
                                <p class="m-0">Products</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="nav-link d-flex align-items-center gap-2 py-2 px-3 rounded">
                                <i class="nav-icon bi bi-grid text-warning fs-5"></i>
                                <p class="m-0">Categories</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Brand" asp-action="Index" class="nav-link d-flex align-items-center gap-2 py-2 px-3 rounded">
                                <i class="nav-icon bi bi-tags text-success fs-5"></i>
                                <p class="m-0">Brands</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Order" asp-action="Index" class="nav-link d-flex align-items-center gap-2 py-2 px-3 rounded">
                                <i class="nav-icon bi bi-cart-check text-primary fs-5"></i>
                                <p class="m-0">Orders</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="User" asp-action="Index" class="nav-link d-flex align-items-center gap-2 py-2 px-3 rounded">
                                <i class="nav-icon bi bi-people text-danger fs-5"></i>
                                <p class="m-0">Users</p>
                            </a>
                        </li>

                        <li class="nav-header text-uppercase text-muted px-3 small fw-bold mt-3 mb-1">Shortcuts</li>
                        <li class="nav-item">
                            <a href="/Customer/Home/Index" class="nav-link d-flex align-items-center gap-2 py-2 px-3 rounded text-white-50">
                                <i class="nav-icon bi bi-arrow-left-circle fs-5"></i>
                                <p class="m-0">Back to Website</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Content Wrapper -->
        <div class="content-wrapper bg-light px-3 py-4">
            <section class="content-header mb-3">
                <div class="container-fluid">
                    <div class="row align-items-center">
                        <div class="col-sm-6">
                            <h1 class="h3 fw-bold text-dark m-0">@(ViewBag.PageTitle ?? "Dashboard")</h1>
                        </div>
                        <div class="col-sm-6 text-sm-right">
                            <ol class="breadcrumb float-sm-right bg-transparent p-0 m-0 small">
                                <li class="breadcrumb-item"><a href="/Admin/Product/Index">Admin</a></li>
                                <li class="breadcrumb-item active">@(ViewBag.PageTitle ?? "Page")</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </section>

            <section class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>
        </div>

        <footer class="main-footer text-muted small py-3 border-top">
            <div class="float-right d-none d-sm-inline">
                <b>CoreMart MVC</b> v1.0
            </div>
            <strong>Copyright &copy; @DateTime.Now.Year CoreMart Admin.</strong> All rights reserved.
        </footer>
    </div>

    <!-- Scripts -->
    <script src="/plugins/jquery/jquery.min.js"></script>
    <script src="/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/dist/js/adminlte.min.js"></script>
    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Script", required: false)
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
